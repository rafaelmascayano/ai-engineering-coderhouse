# Provider: openai, anthropic or openrouter
PROVIDER=openrouter

# Complete only the key required by the selected provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Examples: gpt-4o-mini, claude-3-5-haiku-latest or openrouter/free
MODEL_NAME=openrouter/free
TEMPERATURE=0.0
MAX_TOKENS=2048
TIMEOUT=30

# RAG con OpenRouter + ChromaDB local
RAG_CHAT_MODEL=openrouter/free
RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
RAG_COLLECTION=ley_21442
RAG_DATA_DIR=./data
RAG_VECTORSTORE_DIR=./vectorstore
RAG_TOP_K=4
