# Choose one provider: openai, anthropic or openrouter
PROVIDER=openrouter

# Add the key for the selected provider. Never commit real API keys.
OPENAI_API_KEY=# Choose one provider: openai or anthropic
PROVIDER=openai

# Add the key for the selected provider. Never commit real API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Examples: gpt-4o-mini or claude-3-5-haiku-latest
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=1000
TIMEOUT=30

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Free OpenRouter router. Other examples: gpt-4o-mini or claude-3-5-haiku-latest
MODEL_NAME=openrouter/free
TEMPERATURE=0.7
MAX_TOKENS=1000
TIMEOUT=30
